{
  "info": {
    "name": "TicketHub Notification Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Send custom email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": true
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/email",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "email"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"customer@example.org\",\n  \"recipientName\": \"Asha\",\n  \"subject\": \"Welcome to TicketHub\",\n  \"message\": \"Thanks for joining!\\nEnjoy your shows.\",\n  \"idempotencyKey\": \"welcome-asha-1\"\n}"
        }
      }
    },
    {
      "name": "Trigger booking confirmed (rich details)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": true
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/trigger",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "trigger"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"BOOKING_CONFIRMED\",\n  \"recipientEmail\": \"customer@example.org\",\n  \"recipientName\": \"Asha\",\n  \"bookingId\": 101,\n  \"paymentId\": 55,\n  \"amount\": 700.0,\n  \"currency\": \"INR\",\n  \"showTitle\": \"Inception\",\n  \"venue\": \"PVR Orion, Bengaluru\",\n  \"showTime\": \"Sat 10 Oct 2026, 7:30 PM\",\n  \"seats\": [\n    \"A1\",\n    \"A2\"\n  ]\n}"
        }
      }
    },
    {
      "name": "Trigger payment failed",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": true
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/trigger",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "trigger"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"PAYMENT_FAILED\",\n  \"recipientEmail\": \"customer@example.org\",\n  \"bookingId\": 102,\n  \"paymentId\": 56,\n  \"amount\": 700.0,\n  \"currency\": \"INR\",\n  \"reason\": \"Card declined\"\n}"
        }
      }
    },
    {
      "name": "List notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications?page=0&size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "List FAILED",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications?status=FAILED",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications"
          ],
          "query": [
            {
              "key": "status",
              "value": "FAILED"
            }
          ]
        }
      }
    },
    {
      "name": "List by booking",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications?bookingId=101",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications"
          ],
          "query": [
            {
              "key": "bookingId",
              "value": "101"
            }
          ]
        }
      }
    },
    {
      "name": "Get one",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/{{notificationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "{{notificationId}}"
          ]
        }
      }
    },
    {
      "name": "Preview HTML",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/{{notificationId}}/preview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "{{notificationId}}",
            "preview"
          ]
        }
      }
    },
    {
      "name": "Retry (optionally fix recipient)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": true
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/{{notificationId}}/retry",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "{{notificationId}}",
            "retry"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient\": \"corrected@example.org\"\n}"
        }
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      }
    }
  ]
}