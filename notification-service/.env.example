# Copy to .env (never commit it) and export these before running, or set them in IntelliJ Run Configuration.

# --- Database ---
DB_USERNAME=root
DB_PASSWORD=root

# --- Local testing with MailHog (docker compose up -d)  -> inbox at http://localhost:8025 ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# --- REAL email (Gmail example) : uncomment these and comment the MailHog block above ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.address@gmail.com
# MAIL_PASSWORD=your-16-char-google-app-password
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=your.address@gmail.com
# MAIL_FROM_NAME=TicketHub

# --- Protect the REST API (recommended anywhere except your laptop) ---
# NOTIFICATION_API_KEY=pick-a-long-random-string

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# NOTIFICATION_KAFKA_ENABLED=false     # REST-only mode, no Kafka needed
