# Set these as environment variables (IntelliJ: Run -> Edit Configurations -> Environment variables).
# Every one of them is optional on a laptop - the defaults in application.yml already work.

# Must be IDENTICAL on user-service, booking-service and the gateway (32+ characters)
# JWT_SECRET=use-a-long-random-value-here-0123456789

# SERVER_PORT=8090
# EUREKA_URL=http://localhost:8761/eureka/
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Skip Eureka for a service and call it directly instead:
# BOOKING_SERVICE_URI=http://localhost:8083
# USER_SERVICE_URI=http://localhost:8082
# PAYMENT_SERVICE_URI=http://localhost:8081
# NOTIFICATION_SERVICE_URI=http://localhost:8085
# EVENT_SERVICE_URI=http://localhost:8080

# RATE_LIMIT_ENABLED=false
